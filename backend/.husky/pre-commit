#!/usr/bin/env sh

echo "🔍 Executando lint-staged no frontend..."

# core.hooksPath aponta pra backend/.husky (repo inteiro usa este diretorio),
# entao este hook tambem cobre o frontend em vez de ter um frontend/.husky
# proprio — dois diretorios de hooks nao podem coexistir (git so aceita um
# core.hooksPath por repositorio).
(cd frontend && npx lint-staged)

if [ $? -ne 0 ]; then
  echo "❌ Lint/format do frontend falhou! Corrija os erros antes de fazer commit."
  exit 1
fi

echo "🔍 Executando testes unitários antes do commit..."

# Mudar para diretório backend
cd backend

# Executar testes unitários
npm run test:unit -- --bail --passWithNoTests

# Se testes falharem, abortar commit
if [ $? -ne 0 ]; then
  echo "❌ Testes falharam! Corrija os erros antes de fazer commit."
  exit 1
fi

echo "✅ Testes passaram! Commit permitido."